@model Listing

@if (Model.IsActive == true)
{
    <a href="@Url.Action("Edit", "Listing", new { id = Model.Id, area = "" })" 
    class="btn btn-sm btn-primary-soft mb-0 ms-auto flex-shrink-0">
        <i class="bi bi-pencil fa-fw me-2"></i>Edit your Hotel
    </a>
}
else
{
    <button class="btn btn-sm btn-danger-soft mb-0 ms-auto flex-shrink-0" disabled>
        <i class="bi bi-pencil fa-fw me-2"></i> Your is not active
    </button>       
    <small>please contact support</small>
}