@model List<Booking.Areas.Admin.ViewModels.CityCountryViewModel>


    <div class="card shadow h-100">
    
        <div class="card-header border-bottom d-flex justify-content-between align-items-center p-3">
            <h5 class="card-header-title">City List</h5>
            <a asp-controller="" asp-action="" class="btn btn-link p-0 mb-0">View all</a>
        </div>

        <div class="card-body p-3">
            @foreach (var city in Model)
            {
                <div class="d-flex justify-content-between align-items-center">
                    
                    <div class="d-sm-flex align-items-center mb-1 mb-sm-0">
                       
                        <div class="avatar avatar-md flex-shrink-0">
                            <img class="avatar-img rounded-circle" src="@Url.Content(city.ImageUrl)" alt="@city.CityName">
                        </div>
                      
                        <div class="ms-sm-2 mt-2 mt-sm-0">
                            <h6 class="mb-1">@city.CityName</h6>
                            <ul class="nav nav-divider small">
                                <li class="nav-item">@city.CountryName</li>
                            </ul>
                        </div>
                    </div>
                  
                    <a href="#" class="btn btn-sm btn-light mb-0 ms-3 px-2">
                        <i class="fa-solid fa-chevron-right fa-fw"></i>
                    </a>
                </div>
                <hr> 
            }
        </div>
     
    </div>


