@using Booking.Areas.Admin.ViewModels
@model List<RecentRoomViewModel>


    <div class="card shadow h-100">
        <!-- Card header -->
        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-header-title">Room Notifications</h5>
        </div>

     
        <div class="card-body">
            @foreach (var room in Model)
            {
                <div class="d-flex justify-content-between align-items-center">
                    <!-- Image and info -->
                    <div class="d-sm-flex align-items-center mb-1 mb-sm-0">
                        <!-- Avatar -->
                        <div class="flex-shrink-0">
                            <img src="~/@room.ImagePath" class="rounded h-60px" alt="Room Image">
                        </div>
                        <!-- Info -->
                        <div class="ms-sm-3 mt-2 mt-sm-0">
                            <h6 class="mb-1">@room.RoomId - @room.HotelName</h6>
                            <ul class="nav nav-divider small">
                                <li class="nav-item">@room.City, @room.Country</li>
                                <li class="nav-item"><span class="@(room.BookingStatus == "Booked" ? "text-success" : "text-danger")">@room.BookingStatus</span></li>
                            </ul>
                        </div>
                    </div>
                    <!-- Button -->
                </div>
                <hr>

                <!-- Divider -->
            }
        </div>
        <!-- Card body END -->
    </div>

