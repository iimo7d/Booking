@model IEnumerable<Booking.Models.Blogs>

@{
    ViewData["Title"] = "Manage Blogs";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-content-wrapper p-xxl-4">
    <!-- Title & Create Button -->
    <div class="row">
        <div class="col-12 mb-4 mb-sm-5">
            <div class="d-sm-flex justify-content-between align-items-center">
                <h1 class="h3 mb-3 mb-sm-0">Manage Blogs</h1>
                <div class="d-grid">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createBlogModal">
                        <i class="bi bi-plus-lg me-2"></i>Add New Blog
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Blog List Table -->
    <div class="card shadow mt-5">
        <div class="card-header bg-light rounded p-3 d-none d-lg-block">
            <div class="row row-cols-5 g-4">
                <div class="col"><h6 class="mb-0">Title</h6></div>
                <div class="col"><h6 class="mb-0">Author</h6></div>
                <div class="col"><h6 class="mb-0">Created At</h6></div>
                <div class="col"><h6 class="mb-0">Image</h6></div>
                <div class="col"><h6 class="mb-0">Actions</h6></div>
            </div>
        </div>

        <div class="card-body">
            @foreach (var blog in Model)
            {
                <div class="row row-cols-6 align-items-lg-center border-bottom g-4 px-2 py-4">
                    <div class="col"><h6 class="mb-0 fw-normal">@blog.Title</h6></div>
                    <div class="col"><h6 class="mb-0 fw-normal">@blog.Author</h6></div>
                    <div class="col"><h6 class="mb-0 fw-normal">@blog.CreatedAt.ToShortDateString()</h6></div>
                
                    <div class="col">
                        <img src="@Url.Content("~/" + (string.IsNullOrEmpty(blog.ImageUrl) ? "assets/images/default.jpg" : blog.ImageUrl))"
                             class="rounded" style="width: 60px; height: 60px; object-fit: cover;" alt="Blog Image">
                    </div>
                    <div class="col">
                        <!-- Edit Button -->
                        <button type="button" class="btn btn-sm btn-warning editBlogButton" data-bs-toggle="modal" data-bs-target="#editBlogModal"
                                data-blog-id="@blog.Id" data-blog-title="@blog.Title" data-blog-content="@blog.Content"
                                data-blog-author="@blog.Author" data-blog-published="@blog.IsPublished"
                                data-blog-image="@blog.ImageUrl">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <!-- Delete Button -->
                        <button type="button" class="btn btn-sm btn-danger deleteBlogButton" data-blog-id="@blog.Id">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>


<!-- Create Blog Modal -->
<div class="modal fade" id="createBlogModal" tabindex="-1" aria-labelledby="createBlogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="createBlogForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add New Blog</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Title</label><input type="text" name="Title" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Content</label><textarea name="Content" class="form-control" rows="4" required></textarea></div>
                    <div class="mb-3"><label class="form-label">Author</label><input type="text" name="Author" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Upload Image</label><input type="file" name="image" class="form-control" accept="image/*" /></div>
                    <div class="mb-3"><label class="form-label">Upload Video</label><input type="file" name="video" class="form-control" accept="video/*" /></div>
                    <div class="mb-3 form-check"><input type="checkbox" name="IsPublished" class="form-check-input" value="true"><label class="form-check-label">Publish Now</label></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Blog</button></div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Blog Modal -->
<div class="modal fade" id="editBlogModal" tabindex="-1" aria-labelledby="editBlogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editBlogForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editBlogId" name="Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Blog</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Title</label><input type="text" id="editBlogTitle" name="Title" class="form-control" required /></div>
                    <div class="mb-3"><label class="form-label">Content</label><textarea id="editBlogContent" name="Content" class="form-control" rows="4" required></textarea></div>
                    <div class="mb-3"><label class="form-label">Author</label><input type="text" id="editBlogAuthor" name="Author" class="form-control" required /></div>
                    <div class="mb-3 form-check"><input type="checkbox" id="editBlogPublished" name="IsPublished" class="form-check-input"><label class="form-check-label">Publish Now</label></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Changes</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Prefill Edit Blog Modal
        var editModal = document.getElementById('editBlogModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            $('#editBlogId').val(button.getAttribute('data-blog-id'));
            $('#editBlogTitle').val(button.getAttribute('data-blog-title'));
            $('#editBlogContent').val(button.getAttribute('data-blog-content'));
            $('#editBlogAuthor').val(button.getAttribute('data-blog-author'));
            $('#editBlogPublished').prop('checked', button.getAttribute('data-blog-published') === "True");
        });

        // AJAX: Create Blog
        $('#createBlogForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Create", "Blog")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    Swal.fire(result.success ? 'Success!' : 'Error!', result.message, result.success ? 'success' : 'error')
                        .then(() => { if (result.success) location.reload(); });
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred.', 'error');
                }
            });
        });

        // AJAX: Edit Blog
        $('#editBlogForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Edit", "Blog")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    Swal.fire(result.success ? 'Success!' : 'Error!', result.message, result.success ? 'success' : 'error')
                        .then(() => { if (result.success) location.reload(); });
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred.', 'error');
                }
            });
        });

        // AJAX: Delete Blog
        $('.deleteBlogButton').click(function () {
            var blogId = $(this).data('blog-id');
            Swal.fire({
                title: 'Are you sure?', text: "This action cannot be undone.", icon: 'warning',
                showCancelButton: true, confirmButtonColor: '#dc3545', cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('@Url.Action("Delete", "Blog")', { id: blogId }, function (result) {
                        Swal.fire(result.success ? 'Deleted!' : 'Error!', result.message, result.success ? 'success' : 'error')
                            .then(() => { if (result.success) location.reload(); });
                    });
                }
            });
        });
    </script>
}
