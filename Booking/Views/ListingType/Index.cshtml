@model IEnumerable<Booking.Models.ListingType>

@{
    ViewData["Title"] = "Listing Type List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-content-wrapper p-xxl-4">
    <!-- Page Title -->
    <div class="row">
        <div class="col-12 mb-4 mb-sm-5">
            <div class="d-sm-flex justify-content-between align-items-center">
                <h1 class="h3 mb-3 mb-sm-0">Listing Type List</h1>
                <div class="d-grid">
                    <!-- Trigger Create Modal -->
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createListingTypeModal">
                        <i class="bi bi-plus-lg me-2"></i>Add New Listing Type
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Listing Type List START -->
    <div class="card shadow mt-5">
        <!-- Card header with table head -->
        <div class="card-header bg-light rounded p-3 d-none d-lg-block">
            <div class="row row-cols-3 g-4">
                <div class="col"><h6 class="mb-0">Listing Type</h6></div>
                <div class="col"><h6 class="mb-0">Associated Listings</h6></div>
                <div class="col"><h6 class="mb-0">Actions</h6></div>
            </div>
        </div>

        <!-- Card body -->
        <div class="card-body">
            @foreach (var listingType in Model)
            {
                <div class="row row-cols-3 align-items-lg-center border-bottom g-4 px-2 py-4">
                    <!-- Listing Type Name -->
                    <div class="col">
                        <small class="d-block d-lg-none">Listing Type:</small>
                        <h6 class="mb-0 fw-normal">@listingType.Name</h6>
                    </div>
                    <!-- Associated Listings Count -->
                    <div class="col">
                        <small class="d-block d-lg-none">Associated Listings:</small>
                        <h6 class="mb-0 fw-normal">@listingType.Listings.Count()</h6>
                    </div>
                    <!-- Actions -->
                    <div class="col">
                        <!-- Edit button triggers Edit Modal -->
                        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editListingTypeModal"
                                data-listingtype-id="@listingType.Id" data-listingtype-name="@listingType.Name">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <!-- Delete button triggers SweetAlert -->
                        <button type="button" class="btn btn-sm btn-danger deleteListingTypeButton" data-listingtype-id="@listingType.Id">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        <!-- Card body END -->
        <!-- Card footer -->
        <div class="card-footer pt-0">
            <div class="d-sm-flex justify-content-sm-between align-items-sm-center">
                <p class="mb-sm-0 text-center text-sm-start">Showing @Model.Count() entries</p>
                <nav class="mb-sm-0 d-flex justify-content-center" aria-label="navigation">
                    <!-- Pagination markup if needed -->
                </nav>
            </div>
        </div>
    </div>
    <!-- Listing Type List END -->
</div>

<!-- Create Listing Type Modal -->
<div class="modal fade" id="createListingTypeModal" tabindex="-1" aria-labelledby="createListingTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createListingTypeForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createListingTypeModalLabel">Add New Listing Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Listing Type Name</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
            
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Listing Type</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Listing Type Modal -->
<div class="modal fade" id="editListingTypeModal" tabindex="-1" aria-labelledby="editListingTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editListingTypeForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editListingTypeModalLabel">Edit Listing Type</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Hidden field for Listing Type Id -->
                    <input type="hidden" id="editListingTypeId" name="id" value="" />
                    <div class="mb-3">
                        <label class="form-label">Listing Type Name</label>
                        <input type="text" id="editListingTypeName" name="Name" class="form-control" required />
                    </div>
 
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation using SweetAlert -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Pre-fill Edit Modal from button data attributes.
        var editModal = document.getElementById('editListingTypeModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var listingTypeId = button.getAttribute('data-listingtype-id');
            var listingTypeName = button.getAttribute('data-listingtype-name');
            document.getElementById('editListingTypeId').value = listingTypeId;
            document.getElementById('editListingTypeName').value = listingTypeName;
        });

        // AJAX submission for Create Listing Type Form
        $('#createListingTypeForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Create", "ListingType")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    if (result.success) {
                        Swal.fire('Success!', result.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', result.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred while creating the listing type.', 'error');
                }
            });
        });

        // AJAX submission for Edit Listing Type Form
        $('#editListingTypeForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Edit", "ListingType")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    if (result.success) {
                        Swal.fire('Success!', result.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', result.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred while updating the listing type.', 'error');
                }
            });
        });

        // AJAX submission for Delete Listing Type using SweetAlert
        $('.deleteListingTypeButton').click(function (e) {
            e.preventDefault();
            var listingTypeId = $(this).data('listingtype-id');
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this listing type?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "ListingType")',
                        type: 'POST',
                        data: {
                            id: listingTypeId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                        },
                        success: function (result) {
                            if (result.success) {
                                Swal.fire('Deleted!', result.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error!', result.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'An error occurred while deleting the listing type.', 'error');
                        }
                    });
                }
            });
        });
    </script>
}
