@model IEnumerable<Booking.Models.Country>

@{
    ViewData["Title"] = "Country List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-content-wrapper p-xxl-4">
    <!-- Title -->
    <div class="row">
        <div class="col-12 mb-4 mb-sm-5">
            <div class="d-sm-flex justify-content-between align-items-center">
                <h1 class="h3 mb-3 mb-sm-0">Country List</h1>
                <div class="d-grid">
                    <!-- Trigger Create Country Modal -->
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCountryModal">
                        <i class="bi bi-plus-lg me-2"></i>Add New Country
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Country List START -->
    <div class="card shadow mt-5">
        <!-- Table header in card header -->
        <div class="card-header bg-light rounded p-3 d-none d-lg-block">
            <div class="row row-cols-3 g-4">
                <div class="col"><h6 class="mb-0">Country Name</h6></div>
                <div class="col"><h6 class="mb-0">Total Cities</h6></div>
                <div class="col"><h6 class="mb-0">Actions</h6></div>
            </div>
        </div>

        <!-- Card body: List rows -->
        <div class="card-body">
            @foreach (var country in Model)
            {
                <div class="row row-cols-3 align-items-lg-center border-bottom g-4 px-2 py-4">
                    <!-- Country Name -->
                    <div class="col">
                        <small class="d-block d-lg-none">Country:</small>
                        <h6 class="mb-0 fw-normal">@country.Name</h6>
                    </div>
                    <!-- Total Cities -->
                    <div class="col">
                        <small class="d-block d-lg-none">Total Cities:</small>
                        <h6 class="mb-0 fw-normal">@country.Cities.Count()</h6>
                    </div>
                    <!-- Actions -->
                    <div class="col">
                        <!-- Edit: icon button triggers Edit modal -->
                        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editCountryModal"
                                data-country-id="@country.Id" data-country-name="@country.Name">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <!-- Delete: icon button triggers SweetAlert -->
                        <button type="button" class="btn btn-sm btn-danger deleteCountryButton" data-country-id="@country.Id">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        <!-- Card body END -->
        <!-- Card footer -->
        <div class="card-footer pt-0">
            <div class="d-sm-flex justify-content-sm-between align-items-sm-center">
                <p class="mb-sm-0 text-center text-sm-start">Showing @Model.Count() entries</p>
                <nav class="mb-sm-0 d-flex justify-content-center" aria-label="navigation">
                    <!-- Pagination markup if needed -->
                </nav>
            </div>
        </div>
    </div>
    <!-- Country List END -->
</div>

<!-- Create Country Modal -->
<div class="modal fade" id="createCountryModal" tabindex="-1" aria-labelledby="createCountryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createCountryForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createCountryModalLabel">Add New Country</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Country Name</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
\                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Country</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Country Modal -->
<div class="modal fade" id="editCountryModal" tabindex="-1" aria-labelledby="editCountryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editCountryForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editCountryModalLabel">Edit Country</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Hidden field for country id -->
                    <input type="hidden" id="editCountryId" name="id" value="" />
                    <div class="mb-3">
                        <label class="form-label">Country Name</label>
                        <input type="text" id="editCountryName" name="Name" class="form-control" required />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation using SweetAlert -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Pre-fill Edit Modal fields from button data attributes.
        var editModal = document.getElementById('editCountryModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var countryId = button.getAttribute('data-country-id');
            var countryName = button.getAttribute('data-country-name');

            document.getElementById('editCountryId').value = countryId;
            document.getElementById('editCountryName').value = countryName;
        });

        // AJAX submission for Create Country Form
        $('#createCountryForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Create", "Country")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    if (result.success) {
                        Swal.fire('Success!', result.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', result.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred while creating the country.', 'error');
                }
            });
        });

        // AJAX submission for Edit Country Form
        $('#editCountryForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Edit", "Country")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    if (result.success) {
                        Swal.fire('Success!', result.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', result.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred while updating the country.', 'error');
                }
            });
        });

        // AJAX submission for Delete Country using SweetAlert
        $('.deleteCountryButton').click(function (e) {
            e.preventDefault();
            var countryId = $(this).data('country-id');
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this country?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Country")',
                        type: 'POST',
                        data: {
                            id: countryId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                        },
                        success: function (result) {
                            if (result.success) {
                                Swal.fire('Deleted!', result.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error!', result.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'An error occurred while deleting the country.', 'error');
                        }
                    });
                }
            });
        });
    </script>
}
