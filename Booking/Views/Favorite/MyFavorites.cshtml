@model IEnumerable<Booking.Models.Favorite>

@{
    ViewData["Title"] = "My Favorites";
    Layout = "~/Views/Shared/_ProfileLayout.cshtml";

}

<section >
    <div class="container">
        <div class="card border bg-transparent">
            <!-- Card header -->
            <div class="card-header bg-transparent border-bottom">
                <h4 class="card-header-title">Favorites</h4>
            </div>

            <!-- Card body START -->
            <div class="card-body vstack gap-4">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">You have no favorites yet.</div>
                }
                else
                {
                    @foreach (var fav in Model)
                    {
                        var listing = fav.Listing;
                        <div class="card shadow p-2">
                            <div class="row g-0">
                                <!-- Card img -->
                                <div class="col-md-3">
                                    @if (listing.Images != null && listing.Images.Any())
                                    {
                                        <img src="@Url.Content($"~/{listing.Images.First().ImagePath}")" class="card-img rounded-2" alt="Hotel image">
                                    }
                                    else
                                    {
                                        <img src="~/assets/images/placeholder.jpg" class="card-img rounded-2" alt="No image available">
                                    }
                                </div>

                                <!-- Card body -->
                                <div class="col-md-9">
                                    <div class="card-body d-flex flex-column h-100">
                                        <!-- Rating and buttons -->
                                        <div class="d-flex justify-content-between align-items-center">
                                            <ul class="list-inline small mb-0">
                                                @for (int i = 0; i < listing.Rating; i++)
                                                {
                                                    <li class="list-inline-item me-0"><i class="fa-solid fa-star text-warning"></i></li>
                                                }
                                                <li class="list-inline-item ms-2 h6 small fw-bold mb-0">@listing.Rating/5.0</li>
                                            </ul>

                                            <ul class="list-inline mb-0">
                                                <!-- Heart icon -->
                                                <li class="list-inline-item">
                                                    <a asp-action="RemoveFavorite" class="btn btn-sm btn-round btn-danger mb-0">
                                                        <i class="fa-solid fa-fw fa-heart"></i>
                                                    </a>
                                                </li>
                                                <!-- Share icon -->
                                                <li class="list-inline-item dropdown">
                                                    <a href="#" class="btn btn-sm btn-round btn-light mb-0" role="button" id="dropdownShare_@fav.Id" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="fa-solid fa-fw fa-share-alt"></i>
                                                    </a>
                                                    <ul class="dropdown-menu dropdown-menu-end min-w-auto shadow rounded" aria-labelledby="dropdownShare_@fav.Id">
                                                        <li>
                                                            <a class="dropdown-item" href="#">
                                                                <i class="fab fa-twitter-square me-2"></i>Twitter
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" href="#">
                                                                <i class="fab fa-facebook-square me-2"></i>Facebook
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" href="#">
                                                                <i class="fab fa-linkedin me-2"></i>LinkedIn
                                                            </a>
                                                        </li>
                                                        <li>
                                                            <a class="dropdown-item" href="#">
                                                                <i class="fa-solid fa-copy me-2"></i>Copy link
                                                            </a>
                                                        </li>
                                                    </ul>
                                                </li>
                                            </ul>
                                        </div>

                                        <!-- Title and Address -->
                                        <h5 class="card-title mb-1">
                                            <a href="@Url.Action("Details", "Listing", new { id = listing.Id })">
                                                @listing.Name
                                            </a>
                                        </h5>
                                        <small>
                                            <i class="bi bi-geo-alt me-2"></i>
                                            @listing.Street, @listing.City.Name
                                        </small>

                                        <!-- Price and Button -->
                                        <div class="d-sm-flex justify-content-sm-between align-items-center mt-3 mt-md-auto">
                                            <!-- Price -->
                                            <div class="d-flex align-items-center">
                                                <h5 class="fw-bold mb-0 me-1">$980</h5>
                                                <span class="mb-0 me-2">/day</span>
                                            </div>
                                            <!-- Button -->
                                            <div class="mt-3 mt-sm-0">
                                                <a href="@Url.Action("Details", "Listing", new { id = listing.Id })" class="btn btn-sm btn-dark w-100 mb-0">
                                                    View hotel
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <!-- Card body END -->
        </div>
    </div>
</section>


