@model IEnumerable<Booking.Models.Amenity>

@{
    ViewData["Title"] = "Amenities List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-content-wrapper p-xxl-4">
    <!-- Title -->
    <div class="row">
        <div class="col-12 mb-4 mb-sm-5">
            <div class="d-sm-flex justify-content-between align-items-center">
                <h1 class="h3 mb-3 mb-sm-0">List of Amenities</h1>
                <div class="d-grid">
                    <!-- Trigger Create Amenity Modal -->
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAmenityModal">
                        <i class="bi bi-plus-lg me-2"></i>Add New Amenity
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Amenities List START -->
    <div class="card shadow mt-5">
        <!-- Card header: Table head -->
        <div class="card-header bg-light rounded p-3 d-none d-lg-block">
            <div class="row row-cols-4 g-4">
                <div class="col"><h6 class="mb-0">Amenity</h6></div>
                <div class="col"><h6 class="mb-0">Total Rooms</h6></div>
                <div class="col"><h6 class="mb-0">Actions</h6></div>
            </div>
        </div>

        <!-- Card body: List rows -->
        <div class="card-body">
            @foreach (var amenity in Model)
            {
                <div class="row row-cols-4 align-items-lg-center border-bottom g-4 px-2 py-4">
                    <!-- Amenity Name -->
                    <div class="col">
                        <small class="d-block d-lg-none">Amenity:</small>
                        <h6 class="mb-0 fw-normal">@amenity.Name</h6>
                    </div>

                    <!-- Total Rooms -->
                    <div class="col">
                        <small class="d-block d-lg-none">Total Rooms:</small>
                        <h6 class="mb-0 fw-normal">@amenity.RoomClassAmenities.Count</h6>
                    </div>

                    <!-- Actions -->
                    <div class="col">
                        <!-- Edit button: triggers Edit modal -->
                        <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editAmenityModal"
                                data-amenity-id="@amenity.Id" data-amenity-name="@amenity.Name">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <!-- Delete button: triggers SweetAlert -->
                        <button type="button" class="btn btn-sm btn-danger deleteAmenityButton" data-amenity-id="@amenity.Id">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        <!-- Card body END -->
        <!-- Card footer -->
        <div class="card-footer pt-0">
            <div class="d-sm-flex justify-content-sm-between align-items-sm-center">
                <p class="mb-sm-0 text-center text-sm-start">Showing @Model.Count() entries</p>
                <nav class="mb-sm-0 d-flex justify-content-center" aria-label="navigation">
                    <!-- Pagination markup if needed -->
                </nav>
            </div>
        </div>
    </div>
    <!-- Amenities List END -->
</div>

<!-- Create Amenity Modal -->
<div class="modal fade" id="createAmenityModal" tabindex="-1" aria-labelledby="createAmenityModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createAmenityForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createAmenityModalLabel">Add New Amenity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Amenity Name</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Amenity</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Amenity Modal -->
<div class="modal fade" id="editAmenityModal" tabindex="-1" aria-labelledby="editAmenityModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editAmenityForm" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editAmenityModalLabel">Edit Amenity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Hidden field for amenity id -->
                    <input type="hidden" id="editAmenityId" name="id" value="" />
                    <div class="mb-3">
                        <label class="form-label">Amenity Name</label>
                        <input type="text" id="editAmenityName" name="Name" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation using SweetAlert -->
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Pre-fill Edit Modal
        var editModal = document.getElementById('editAmenityModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var amenityId = button.getAttribute('data-amenity-id');
            var amenityName = button.getAttribute('data-amenity-name');

            document.getElementById('editAmenityId').value = amenityId;
            document.getElementById('editAmenityName').value = amenityName;
        });

        // AJAX submission for Create Amenity Form
        $('#createAmenityForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Create", "Amenity")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    if (result.success) {
                        Swal.fire('Success!', result.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', result.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred while creating the amenity.', 'error');
                }
            });
        });

        // AJAX submission for Edit Amenity Form
        $('#editAmenityForm').submit(function (e) {
            e.preventDefault();
            var formData = new FormData(this);
            $.ajax({
                url: '@Url.Action("Edit", "Amenity")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (result) {
                    if (result.success) {
                        Swal.fire('Success!', result.message, 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error!', result.message, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error!', 'An error occurred while updating the amenity.', 'error');
                }
            });
        });

        // AJAX submission for Delete Amenity using SweetAlert
        $('.deleteAmenityButton').click(function (e) {
            e.preventDefault();
            var amenityId = $(this).data('amenity-id');
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this amenity?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Amenity")',
                        type: 'POST',
                        data: {
                            id: amenityId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                        },
                        success: function (result) {
                            if (result.success) {
                                Swal.fire('Deleted!', result.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error!', result.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'An error occurred while deleting the amenity.', 'error');
                        }
                    });
                }
            });
        });
    </script>
}
