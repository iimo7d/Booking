@model IEnumerable<RoomClass>

@{
    ViewData["Title"] = "Room Class List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-content-wrapper p-xxl-4">
    <!-- Title and Add Button -->
    <div class="row">
        <div class="col-12 mb-4 mb-sm-5">
            <div class="d-sm-flex justify-content-between align-items-center">
                <h1 class="h3 mb-3 mb-sm-0">Room Class List</h1>
                <button type="button" class="btn btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#createRoomClassModal">
                    <i class="bi bi-plus-lg me-2"></i> Add New Room Class
                </button>
            </div>
        </div>
    </div>

    <!-- Room Class List -->
    <div class="card shadow mt-5">
        <div class="card-body">
            <div class="bg-light rounded p-3 d-none d-lg-block">
                <div class="row row-cols-4 g-4">
                    <div class="col"><h6 class="mb-0">Name</h6></div>
                    <div class="col"><h6 class="mb-0">Total Rooms</h6></div>
                    <div class="col"><h6 class="mb-0">Actions</h6></div>
                </div>
            </div>

            @foreach (var roomClass in Model)
            {
                <div class="row row-cols-4 align-items-lg-center border-bottom g-4 px-2 py-4">
                    <div class="col">
                        <h6 class="mb-0 fw-normal">@roomClass.Name</h6>
                    </div>
                    <div class="col">
                        <h6 class="mb-0 fw-normal">@roomClass.Rooms.Count</h6>
                    </div>
                    <div class="col">
                        <button type="button" class="btn btn-sm btn-warning edit-room-class"
                                data-bs-toggle="modal" data-bs-target="#editRoomClassModal"
                                data-id="@roomClass.Id" data-name="@roomClass.Name">
                            Edit
                        </button>
                        <button type="button" class="btn btn-sm btn-danger delete-room-class" data-id="@roomClass.Id">
                            Delete
                        </button>
                    </div>
                </div>
            }
        </div>
        <div class="card-footer pt-0">
            <p class="mb-0 text-center">Showing @Model.Count() entries</p>
        </div>
    </div>
</div>

<!-- Create Room Class Modal -->
<div class="modal fade" id="createRoomClassModal" tabindex="-1" aria-labelledby="createRoomClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createRoomClassForm">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Room Class</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" id="createRoomClassName" name="Name" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Room Class Modal -->
<div class="modal fade" id="editRoomClassModal" tabindex="-1" aria-labelledby="editRoomClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editRoomClassForm">
                <input type="hidden" id="editRoomClassId" name="Id" />
                <div class="modal-header">
                    <h5 class="modal-title">Edit Room Class</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" id="editRoomClassName" name="Name" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {

            // CREATE
            $("#createRoomClassForm").submit(function (e) {
                e.preventDefault();
                var formData = $(this).serialize();

                $.post("@Url.Action("Create", "RoomClass")", formData)
                    .done(function (data) {
                        Swal.fire("Success!", data.message, "success")
                            .then(() => location.reload());
                    })
                    .fail(function () {
                        Swal.fire("Error!", "Something went wrong!", "error");
                    });
            });

            // EDIT MODAL POPULATE
            $('#editRoomClassModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var name = button.data('name');

                $('#editRoomClassId').val(id);
                $('#editRoomClassName').val(name);
            });

            // EDIT
            $("#editRoomClassForm").submit(function (e) {
                e.preventDefault();
                var formData = $(this).serialize();

                $.post("@Url.Action("Edit", "RoomClass")", formData)
                    .done(function (data) {
                        Swal.fire("Updated!", data.message, "success")
                            .then(() => location.reload());
                    })
                    .fail(function () {
                        Swal.fire("Error!", "Something went wrong!", "error");
                    });
            });

            // DELETE WITH SWEET ALERT
            $(".delete-room-class").click(function () {
                var id = $(this).data("id");

                Swal.fire({
                    title: "Are you sure?",
                    text: "This action cannot be undone!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@Url.Action("Delete", "RoomClass")",
                            type: "POST",
                            data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                            success: function (data) {
                                Swal.fire("Deleted!", data.message, "success")
                                    .then(() => location.reload());
                            },
                            error: function () {
                                Swal.fire("Error!", "Something went wrong!", "error");
                            }
                        });
                    }
                });
            });

        });
    </script>
}
