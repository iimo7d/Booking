@using Booking.ViewModels.Listing
@model MultiRoomClassAmenityAssignmentVM

@{
    ViewData["Title"] = "Assign Amenities to Room Classes";
}





<section class="pt-0">
    <div class="container">
        <!-- Background image -->
        <div class="rounded-3 p-3 p-sm-5" style="background-image: url(@Url.Content("~/assets/images/bg/05.jpg")); background-position: center center; background-repeat: no-repeat; background-size: cover;">
            <!-- Banner title -->
            <div class="row my-2 my-xl-5">
                <div class="col-md-8 mx-auto">
                    <h1 class="text-center text-white">@ViewBag.ListingName  </h1>
                    <h1 class="text-center text-white">Assign amenities </h1>
                </div>
            </div>
        </div>
    </div>
</section>




<section class="pt-0">
<div class="container ">

        <h5 class="text-center text-black">Room Types </h5>


    <form asp-action="MultiAssignAmenity" method="post">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ListingId)

        <div class="accordion" id="roomClassesAccordion">
            @for (int i = 0; i < Model.RoomClassAssignments.Count; i++)
            {
                var assignment = Model.RoomClassAssignments[i];
                <div class="accordion-item mb-2">
                    <h2 class="accordion-header" id="heading@(i)">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(i)" aria-expanded="false" aria-controls="collapse@(i)">
                            @assignment.RoomClassName
                        </button>
                    </h2>
                    <div id="collapse@(i)" class="accordion-collapse collapse" aria-labelledby="heading@(i)" data-bs-parent="#roomClassesAccordion">
                        <div class="accordion-body">
                            <!-- Hidden field to persist the room class ID -->
                            <input type="hidden" name="RoomClassAssignments[@(i)].RoomClassId" value="@assignment.RoomClassId" />

                            <div class="row">
                                @foreach (var amenity in Model.AmenityList)
                                {
                                    var amenityId = int.Parse(amenity.Value);
                                    bool isAssigned = assignment.SelectedAmenityIds.Contains(amenityId);
                                    <div class="col-12 col-md-4 mb-2">
                                        <div class="form-check">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   name="RoomClassAssignments[@(i)].SelectedAmenityIds"
                                                   value="@amenity.Value"
                                                   id="amenity_@(assignment.RoomClassId)_@(amenity.Value)"
                                            @(isAssigned ? "checked" : "") />
                                            <label class="form-check-label" for="amenity_@(assignment.RoomClassId)_@(amenity.Value)">
                                                @amenity.Text
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
    </form>
</div>
</section>