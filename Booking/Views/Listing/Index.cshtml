@model IEnumerable<Booking.Models.Listing>

@{
    ViewData["Title"] = "Hotel Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="pt-0">
    <div class="container">
        <!-- Background image -->
        <div class="rounded-3 p-3 p-sm-5" style="background-image: url(@Url.Content("~/assets/images/bg/05.jpg")); background-position: center center; background-repeat: no-repeat; background-size: cover;">
            <!-- Banner title -->
            <div class="row my-2 my-xl-5">
                <div class="col-md-8 mx-auto text-center">
                    <h1 class="text-white">
                        Explore our hotels to begin your journy
                    </h1>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- =======================
Title and Tabs START -->
<section class="pt-0 pb-4">
    <div class="container position-relative">

        <!-- Title and button START -->
        <div class="row">
            <div class="col-12">
                <!-- Meta START -->
                <div class="d-flex justify-content-between">
                    <!-- Filter collapse button -->
                    <input type="checkbox" class="btn-check" id="btn-check-soft">
                    <label class="btn btn-primary-soft btn-primary-check mb-0" for="btn-check-soft" data-bs-toggle="collapse" data-bs-target="#collapseFilter" aria-controls="collapseFilter">
                        <i class="bi fa-fe bi-sliders me-2"></i>Show Filters
                    </label>

                    <!-- tabs -->
                </div>
                <!-- Meta END -->
            </div>
        </div>
        <!-- Title and button END -->
        <!-- Collapse body START -->
        <div class="collapse" id="collapseFilter">
            <div class="card card-body bg-light p-4 mt-4 z-index-9">

                <!-- Form START -->
                <form method="get" class="row g-4">
                    <!-- Input item -->
                    <div class="col-md-6 col-lg-4">
                        <div class="form-control-borderless">
                            <label class="form-label">Enter Hotel Name</label>
                            <input type="text" name="hotelName" class="form-control form-control-lg" value="@ViewContext.HttpContext.Request.Query["hotelName"]">
                        </div>
                    </div>

                    <!-- nouislider item -->
                    <div class="col-md-6 col-lg-4">
                        <div class="form-control-borderless">
                            <label class="form-label">Price Range</label>
                            <div class="position-relative">
                                <div class="noui-wrapper">
                                    <div class="d-flex justify-content-between">
                                        <input type="number" name="minPrice" class="text-body input-with-range-min" placeholder="Min" value="@ViewContext.HttpContext.Request.Query["minPrice"]" />
                                        <input type="number" name="maxPrice" class="text-body input-with-range-max" placeholder="Max" value="@ViewContext.HttpContext.Request.Query["maxPrice"]" />
                                    </div>
                                    <div class="noui-slider-range mt-2" data-range-min='500' data-range-max='2000' data-range-selected-min='700' data-range-selected-max='1500'></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Select item -->
                    <div class="col-md-6 col-lg-4">
                        <div class="form-size-lg form-control-borderless">
                            <label class="form-label">Popular Filters</label>
                            <select name="roomClassIds" asp-items="@ViewBag.RoomClasses" multiple="multiple" class="form-select js-choice border-0">
                            </select>
                        </div>
                    </div>

                    <!-- Customer rating -->
                    <div class="col-md-6 col-lg-4">
                        <div class="form-control-borderless">
                            <label class="form-label">Customer Rating</label>
                            <ul class="list-inline mb-0 g-3">
                                <!-- 1 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" value="3" name="customerRatings" @(ViewContext.HttpContext.Request.Query["customerRatings"].Contains("3") ? "checked" : "") id="btn-check-1">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-1">3+</label>
                                </li>
                                <!-- 2 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" name="customerRatings" value="3.5" @(ViewContext.HttpContext.Request.Query["customerRatings"].Contains("3.5") ? "checked" : "") id="btn-check-2">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-2">3.5+</label>
                                </li>
                                <!-- 3 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" name="customerRatings" value="4" @(ViewContext.HttpContext.Request.Query["customerRatings"].Contains("4") ? "checked" : "") id="btn-check-3">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-3">4+</label>
                                </li>
                                <!-- 4 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" name="customerRatings" value="4.5" @(ViewContext.HttpContext.Request.Query["customerRatings"].Contains("4.5") ? "checked" : "")id="btn-check-4">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-4">4.5+</label>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Star rating -->
                    <div class="col-md-6 col-lg-4">
                        <div class="form-control-borderless">
                            <label class="form-label">Star Rating</label>
                            <ul class="list-inline mb-0 g-3">
                                <!-- 1 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" id="btn-check-9" name="starRatings" value="1" @(ViewContext.HttpContext.Request.Query["starRatings"].Contains("1") ? "checked" : "")>
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-9">1<i class="bi bi-star-fill"></i></label>
                                </li>
                                <!-- 2 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" name="starRatings" value="2" @(ViewContext.HttpContext.Request.Query["starRatings"].Contains("2") ? "checked" : "") id="btn-check-10">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-10">2<i class="bi bi-star-fill"></i></label>
                                </li>
                                <!-- 3 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" name="starRatings" value="3" @(ViewContext.HttpContext.Request.Query["starRatings"].Contains("3") ? "checked" : "") id="btn-check-11">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-11">3<i class="bi bi-star-fill"></i></label>
                                </li>
                                <!-- 4 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" name="starRatings" value="4" @(ViewContext.HttpContext.Request.Query["starRatings"].Contains("4") ? "checked" : "") id="btn-check-12">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-12">4<i class="bi bi-star-fill"></i></label>
                                </li>
                                <!-- 4 -->
                                <li class="list-inline-item">
                                    <input type="checkbox" class="btn-check" name="starRatings" value="5" @(ViewContext.HttpContext.Request.Query["starRatings"].Contains("5") ? "checked" : "") id="btn-check-13">
                                    <label class="btn btn-white btn-primary-soft-check" for="btn-check-13">5<i class="bi bi-star-fill"></i></label>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Select item -->
                    <div class="col-md-6 col-lg-4">
                        <div class="form-size-lg form-control-borderless">
                            <label class="form-label">Hotel Type</label>
                            <select class="form-select js-choice border-0" name="listingTypeId" asp-items="ViewBag.ListingTypes">
                                <option value="">Select Option</option>
                            </select>
                        </div>
                    </div>


                    <button type="submit" class="btn btn-primary-soft mt-3">Apply Filters</button>
                </form>
                <!-- Form END -->
            </div>
        </div>
        <!-- Collapse body END -->

    </div>
</section>
<!-- =======================
Title and Tabs END -->
<!-- =======================
Hotel grid START -->
<section class="pt-0">
    <div class="container">
        <div class="row g-4">

            @foreach (var hotel in Model)
            {

                <div class="col-md-6 col-xl-4">
                    <div class="card shadow p-2 pb-0 h-100">

                        <div class="tiny-slider arrow-round arrow-xs arrow-dark rounded-2 overflow-hidden">
                            <div class="tiny-slider-inner" data-autoplay="false" data-arrow="true" data-dots="false" data-items="1">

                                @foreach (var image in hotel.Images)
                                {
                                    <div style="max-height:250px; max-width:auto;"><img src="~/@image.ImagePath" alt="Card image"></div>

                                }
                            </div>
                        </div>

                        <div class="card-body px-3 pb-0">
                            <!-- Rating and cart -->

                            <h5 class="card-title">
                                <a href="@Url.Action("Details", "Listing", new { id = hotel.Id })">@hotel.Name</a>
                            </h5>
                            <ul class="nav nav-divider mb-2 mb-sm-3">
                                <li class="nav-item">@hotel.Street-@hotel.City?.Name</li>
                            </ul>

                            <!-- List -->
                            <ul class="nav nav-divider mb-2 mb-sm-3">
                                @foreach (var roomClass in hotel.ListingRoomClasses.Take(4))
                                {
                                    <li class="nav-item">@roomClass.RoomClass.Name</li>


                                }

                                <li class="nav-item hover-element"><a href="@Url.Action("Details", "Listing", new { id = hotel.Id })">More+</a></li>


                            </ul>
                        </div>
                        <!-- Card body END -->
                        <!-- Card footer START-->
                        <div class="card-footer pt-0">
                            <!-- Price and Button -->
                            <div class="d-sm-flex justify-content-sm-between align-items-center">
                                <!-- Price -->
                                <div class="d-flex align-items-center">
                                    <h5 class="fw-normal text-success mb-0 me-1">$@hotel.StarterPrice</h5>
                                    <span class="mb-0 me-2">/day</span>
                                </div>
                                <!-- Button -->
                                <div class="mt-2 mt-sm-0">
                                    <a href="@Url.Action("Details", "Listing", new { id = hotel.Id })" class="btn btn-sm btn-primary-soft mb-0 w-100">View Detail<i class="bi bi-arrow-right ms-2"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            }


            <!-- Card item START -->

        </div> <!-- Row END -->
        <!-- Pagination -->
        <div class="row">
            <div class="col-12">
                <nav class="mt-4 d-flex justify-content-center" aria-label="navigation">
                    <ul class="pagination pagination-primary-soft d-inline-block d-md-flex rounded mb-0">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item mb-0">
                                <a class="page-link" href="@Url.Action("Index", new {
                                    page = ViewBag.CurrentPage - 1,
                                    hotelName = ViewContext.HttpContext.Request.Query["hotelName"],
                                    listingTypeId = ViewContext.HttpContext.Request.Query["listingTypeId"],
                                    minPrice = ViewContext.HttpContext.Request.Query["minPrice"],
                                    maxPrice = ViewContext.HttpContext.Request.Query["maxPrice"],
                                    starRatings = ViewContext.HttpContext.Request.Query["starRatings"],
                                    customerRatings = ViewContext.HttpContext.Request.Query["customerRatings"],
                                    roomClassIds = ViewContext.HttpContext.Request.Query["roomClassIds"],
                                    cityId = ViewContext.HttpContext.Request.Query["cityId"]
                                })" tabindex="-1">
                                    <i class="fa-solid fa-angle-left"></i>
                                </a>
                            </li>
                        }
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                <li class="page-item mb-0 active">
                                    <a class="page-link" href="#">@i</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item mb-0">
                                    <a class="page-link" href="@Url.Action("Index", new {
                                        page = i,
                                        hotelName = ViewContext.HttpContext.Request.Query["hotelName"],
                                        listingTypeId = ViewContext.HttpContext.Request.Query["listingTypeId"],
                                        minPrice = ViewContext.HttpContext.Request.Query["minPrice"],
                                        maxPrice = ViewContext.HttpContext.Request.Query["maxPrice"],
                                        starRatings = ViewContext.HttpContext.Request.Query["starRatings"],
                                        customerRatings = ViewContext.HttpContext.Request.Query["customerRatings"],
                                        roomClassIds = ViewContext.HttpContext.Request.Query["roomClassIds"],
                                        cityId = ViewContext.HttpContext.Request.Query["cityId"]
                                    })">@i</a>
                                </li>
                            }
                        }
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item mb-0">
                                <a class="page-link" href="@Url.Action("Index", new {
                                    page = ViewBag.CurrentPage + 1,
                                    hotelName = ViewContext.HttpContext.Request.Query["hotelName"],
                                    listingTypeId = ViewContext.HttpContext.Request.Query["listingTypeId"],
                                    minPrice = ViewContext.HttpContext.Request.Query["minPrice"],
                                    maxPrice = ViewContext.HttpContext.Request.Query["maxPrice"],
                                    starRatings = ViewContext.HttpContext.Request.Query["starRatings"],
                                    customerRatings = ViewContext.HttpContext.Request.Query["customerRatings"],
                                    roomClassIds = ViewContext.HttpContext.Request.Query["roomClassIds"],
                                    cityId = ViewContext.HttpContext.Request.Query["cityId"]
                                })">
                                    <i class="fa-solid fa-angle-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- =======================
Hotel grid END -->
