@model List<Booking.Models.Room>

<div class="card bg-transparent">
    <!-- Card header -->
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center border-bottom">
        <h6 class="m-0">Selected Rooms</h6>
        <a class="small" href="#" onclick="clearCart()">Clear all</a>
    </div>

    <!-- Card body START -->
    <div class="card-body p-0">
        @if (Model == null || !Model.Any())
        {
            <p class="p-3 mb-0">No rooms in cart.</p>
        }
        else
        {
            <ul class="list-group list-group-flush list-unstyled p-2">
                @foreach (var room in Model)
                {
                    <li class="list-group-item list-group-item-action rounded border-0 mb-1 p-2">
                        <h6 class="mb-1">@room.RoomNo</h6>
                        <small>Listing: @room.Listing?.Name</small> <br />
                        <small>Price: @room.PricePerNight.ToString("C")</small>
                        <br />
                        <button class="btn btn-sm btn-danger mt-2" onclick="removeRoom(@room.Id)">X</button>
                    </li>
                }
            </ul>
        }
    </div>
    <!-- Card body END -->
    <!-- Card footer -->
    <div class="card-footer bg-transparent text-center border-top">
        <a href="@Url.Action("Checkout", "Booking")" class="btn btn-sm btn-link mb-0 p-0">Book</a>
    </div>
</div>
