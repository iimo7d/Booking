@using Booking.Services
@{
    var cartRoomIds = Context.Session.GetObjectFromJson<List<int>>("RoomCart") ?? new List<int>();
}
@model BookingVM

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    section {
        min-height: 100vh;
        /* Optional: to vertically center or stretch content */
        display: flex;
        flex-direction: column;
    }
</style>

<section>
    <!-- Use container-fluid for full width -->
    <div class="container-fluid">
        <div class="row g-4 g-lg-5">
            <!-- Adjust column classes if necessary; using col-12 fills full width -->
            <div class="col-12">
                <div class="vstack gap-5">
                    <!-- Hotel information START -->
                    <div class="card shadow">
                        <div class="card-header p-4 border-bottom">
                            <h3 class="mb-0"><i class="fa-solid fa-hotel me-2"></i>Hotel Information</h3>
                        </div>
                        <div class="card-body p-4">
                            <div class="card mb-4">
                                <div class="row align-items-center">
                                    <div class="col-sm-6 col-md-3">
                                        <img src="~/@ViewBag.ImageUrl" class="card-img" alt="">
                                    </div>
                                    <div class="col-sm-6 col-md-9">
                                        <div class="card-body pt-3 pt-sm-0 p-0">
                                            <h5 class="card-title">
                                                <a href="@Url.Action("Details","Listing",new { id=@ViewBag.ListingId })">
                                                    @ViewBag.HotelName
                                                </a>
                                            </h5>
                                            <p class="small mb-2">
                                                <i class="bi bi-geo-alt me-2"></i>
                                                @ViewBag.Address
                                            </p>
                                            <p>
                                                @ViewBag.Desciprtion
                                            </p>
                                            <ul class="list-inline mb-0">
                                                @if (ViewBag.Rate != null)
                                                {
                                                    for (int i = 0; i < ViewBag.Rate; i++)
                                                    {
                                                        <li class="list-inline-item me-0 small">
                                                            <i class="fa-solid fa-star text-warning"></i>
                                                        </li>
                                                    }
                                                }

                                                <li class="list-inline-item ms-2 h6 small fw-bold mb-0">
                                                    @ViewBag.Rate/5.0
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Selected Rooms Card -->
                            <div class="card border mt-4">
                                <div class="card-header border-bottom d-md-flex justify-content-md-between">
                                    <h5 class="card-title mb-0">Selected Rooms</h5>
                                </div>
                                <div class="card-body scrollable-card-body">
                                    @foreach (var room in Model.Rooms)
                                    {
                                        bool inCart = cartRoomIds.Contains(room.Id);
                                        <div class="card shadow p-3 mb-3">
                                            <div class="row g-4">
                                                <div class="col-md-5 position-relative">
                                                    <div class="tiny-slider arrow-round arrow-xs arrow-dark overflow-hidden rounded-2">
                                                        <div class="tiny-slider-inner" data-autoplay="true" data-arrow="true" data-dots="false" data-items="1">
                                                            @foreach (var image in room.Images)
                                                            {
                                                                <div>
                                                                    <img src="@Url.Content($"~/{image.ImagePath}")" alt="Card image">
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-7">
                                                    <div class="card-body d-flex flex-column h-100 p-0">
                                                        <h5 class="card-title">
                                                            <a href="#">@room.RoomNo</a>
                                                        </h5>
                                                        <small>@room.RoomClass?.Name</small>
                                                        @if (room.RoomClass != null && room.RoomClass.RoomClassAmenities.Any(a => a.ListingId == room.ListingId))
                                                        {
                                                            var amenities = room.RoomClass.RoomClassAmenities
                                                            .Where(a => a.ListingId == ViewBag.ListingId)
                                                            .OrderBy(a => Guid.NewGuid())
                                                            .Take(4)
                                                            .Select(a => a.Amenity.Name)
                                                            .ToList();
                                                            if (amenities.Any())
                                                            {
                                                                <ul class="nav nav-divider mb-2">
                                                                    @foreach (var amenity in amenities)
                                                                    {
                                                                        <li class="nav-item">@amenity</li>
                                                                    }
                                                                </ul>
                                                            }
                                                        }
                                                        <div class="d-sm-flex justify-content-sm-between align-items-center mt-auto">
                                                            <div class="d-flex align-items-center">
                                                                <h5 class="fw-bold mb-0 me-1">@room.PricePerNight</h5>
                                                                <span class="mb-0 me-2">/day</span>
                                                            </div>
                                                            @if (!room.IsBooked && !inCart)
                                                            {
                                                                <div class="mt-3 mt-sm-0">
                                                                    <a id="selectRoomBtn_@room.Id" onclick="addRoom(@room.Id)" class="btn btn-sm btn-primary mb-0">Select Room</a>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Reservation Data START -->
                    <div class="card shadow">
                        <div class="card-header border-bottom p-4">
                            <h4 class="card-title mb-0"><i class="bi bi-people-fill me-2"></i>Reservation Data</h4>
                        </div>
                        <div class="card-body p-4">
                            <form class="row g-4" asp-action="Checkout" method="post">
                                @Html.AntiForgeryToken()
                                <div class="form-control-border form-control-transparent form-fs-md">
                                    <label class="form-label">First Name</label>
                                    <input type="text" value="@Model.AppUser.FirstName" class="form-control form-control-lg" disabled placeholder="Enter your name">
                                    <label class="form-label">Last Name</label>
                                    <input type="text" value="@Model.AppUser.LastName" disabled class="form-control form-control-lg" placeholder="Enter your name">
                                </div>
                                <div class="form-control-border form-control-transparent form-fs-md">
                                    <label class="form-label">Check In</label>
                                    <input type="text" asp-for="CheckInDate" id="checkInDate" name="checkInDate" class="form-control flatpickr" placeholder="Select check In date">
                                </div>
                                <div class="form-control-border form-control-transparent form-fs-md">
                                    <label class="form-label">Check Out</label>
                                    <input type="text" asp-for="CheckOutDate" id="checkOutDate" name="CheckOutDate" class="form-control flatpickr" placeholder="Select check out date">
                                </div>

                                <button type="submit" class="btn btn-primary">Checkout</button>
                            </form>
                        </div>
                    </div>
                    <!-- Reservation Data END -->
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}